# Copy to .env in the directory from which you start artifactory-mcp.
# Existing environment variables take precedence, even when empty.
ARTIFACTORY_URL=https://example.jfrog.io/artifactory
ARTIFACTORY_ACCESS_TOKEN='your-access-token'

# Optional settings:
# ARTIFACTORY_REPOSITORIES=libs-release-local,libs-snapshot-local
# MCP_LOG_LEVEL=info
# MCP_TRANSPORT=stdio
# MCP_DISABLE_TOOLS=list_builds,get_build_info
